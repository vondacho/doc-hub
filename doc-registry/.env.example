# Local development. Copy to .env and fill the secrets in — `npm run develop`
# generates a set for you on first run if the file is missing.
#
# In the cluster none of this file is used: helm/doc-registry renders the
# non-secret half into a ConfigMap and generates the secret half into a Secret,
# and both are injected with envFrom.

HOST=0.0.0.0
PORT=1337

# Secrets. Rotating ENCRYPTION_KEY makes already-stored encrypted fields
# unreadable; rotating APP_KEYS or ADMIN_JWT_SECRET signs every admin out.
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# Database. config/database.ts picks the connection block from DATABASE_CLIENT
# and ships connectors for sqlite, postgres and mysql. The file path is
# relative to the project root.
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db

# Postgres instead — the same variables the chart sets when database.client is
# switched over:
# DATABASE_CLIENT=postgres
# DATABASE_HOST=localhost
# DATABASE_PORT=5432
# DATABASE_NAME=strapi
# DATABASE_USERNAME=strapi
# DATABASE_PASSWORD=strapi
# DATABASE_SSL=false

# src/index.ts loads the sixteen placeholder products into an *empty*
# collection on boot. Unset or "false" leaves the registry alone.
SEED_PRODUCTS=true

# Grant the public role find/findOne on /api/products, so doc-portal can read
# the catalogue without a token. "false" leaves the role untouched.
PUBLIC_READ=true
