---
import Layout from '../layouts/Layout.astro';
import { SAMPLE_SOURCE } from '../lib/storymap/sample';

// Server-rendered with no script, like every page in doc-hub except the board.
// A format reference is prose; it has nothing to hydrate.
export const prerender = true;

const rules: { title: string; body: string }[] = [
	{
		title: 'Braces, not indentation',
		body: 'Whitespace is a formatting choice and never syntax. A file that has been through a chat window, an editor with different tab settings, or a copy-paste still parses.',
	},
	{
		title: 'Release order is band order',
		body: 'The releases are read top to bottom in the order they are declared. There is no index to drift out of step with the file.',
	},
	{
		title: 'No @release means below the line',
		body: 'A story with no release is known and not committed to. Absence is the encoding — there is no keyword for it to get wrong.',
	},
	{
		title: 'Release titles must be unique',
		body: 'A story refers to a release by its title, so two releases cannot share one. This is what keeps identifiers out of the file entirely.',
	},
	{
		title: 'Empty cards are real',
		body: 'A step with no stories, or an activity with no steps, keeps its place. Both are ordinary states mid-workshop, and dropping them on export would delete a column.',
	},
	{
		title: 'Comments do not survive the board',
		body: 'A // comment is read and discarded. Import a commented file, export it again, and the comments are gone — the board is the source, the file is a render of it.',
	},
];
---

<Layout
	title="The .storymap format — doc-hub"
	description="The text format a doc-hub story map is exported to and imported from."
>
	<main id="main" class="mx-auto w-full max-w-5xl px-6 py-12 sm:py-16">
		<p class="text-xs font-semibold tracking-[0.16em] text-ink-muted uppercase dark:text-slate-400">
			doc-hub · story mapping
		</p>
		<h1 class="mt-2 text-3xl font-bold sm:text-4xl">The <code>.storymap</code> format</h1>
		<p class="mt-3 max-w-prose text-ink-muted dark:text-slate-400">
			A story map is a text file. It belongs in the repository of the product it describes, where it
			diffs, reviews and merges like everything else there — which is the whole reason the board keeps
			nothing of its own.
		</p>

		<section aria-labelledby="example" class="mt-10">
			<h2 id="example" class="text-xl font-bold">An example</h2>
			<div class="mt-3 overflow-x-auto rounded-2xl border border-slate-200 bg-white p-4 dark:border-slate-700 dark:bg-night-raised">
				<pre class="text-xs leading-relaxed"><code>{SAMPLE_SOURCE}</code></pre>
			</div>
			<p class="mt-3 max-w-prose text-sm text-ink-muted dark:text-slate-400">
				Two cards in it are carrying a point. <code>story "Saved searches"</code> has no
				<code>@</code>, so it sits below the line. <code>step "Open a product"</code> has no body at
				all — a step that has been named and has no stories yet.
			</p>
		</section>

		<section aria-labelledby="rules" class="mt-12">
			<h2 id="rules" class="text-xl font-bold">What the format decides for you</h2>
			<dl class="mt-4 grid gap-5 sm:grid-cols-2">
				{
					rules.map((rule) => (
						<div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-700 dark:bg-night-raised">
							<dt class="font-semibold">{rule.title}</dt>
							<dd class="mt-1.5 text-sm text-ink-muted dark:text-slate-400">{rule.body}</dd>
						</div>
					))
				}
			</dl>
		</section>

		<section aria-labelledby="grammar" class="mt-12">
			<h2 id="grammar" class="text-xl font-bold">The grammar</h2>
			<div class="mt-3 overflow-x-auto rounded-2xl border border-slate-200 bg-white p-4 dark:border-slate-700 dark:bg-night-raised">
				<pre class="text-xs leading-relaxed"><code>{`File        = StoryMap , EOF ;
StoryMap    = 'storymap' , String , [ '{' , { Release | Activity | Note } , '}' ] ;
Release     = 'release'  , String , [ '{' , { Note } , '}' ] ;
Activity    = 'activity' , String , [ '{' , { Step | Note } , '}' ] ;
Step        = 'step'     , String , [ '{' , { Story | Note } , '}' ] ;
Story       = 'story'    , String , [ ReleaseRef ] , [ '{' , { Note } , '}' ] ;
Note        = 'note'     , String ;
ReleaseRef  = '@' , ( Ident | String ) ;
String      = '"' , { Char | '\\' , ( '"' | '\\' | 'n' | 't' ) } , '"' ;
Ident       = ( Letter | '_' ) , { Letter | Digit | '_' | '-' } ;
Comment     = '//' , { Char } ;   (* discarded *)`}</code></pre>
			</div>
			<p class="mt-3 max-w-prose text-sm text-ink-muted dark:text-slate-400">
				Every name is a quoted string, so a title can never collide with a keyword. Write
				<code>@MVP</code> when the release name is one word, <code>@"Q3 2026"</code> when it is not —
				the board picks the right form for you on export.
			</p>
		</section>

		<p class="mt-12">
			<a
				href="/"
				class="rounded-full bg-brand px-5 py-2.5 font-semibold text-white transition hover:bg-brand-strong focus-visible:outline-2 focus-visible:outline-offset-3 focus-visible:outline-brand motion-reduce:transition-none"
			>
				Open the board
			</a>
		</p>
	</main>
</Layout>
