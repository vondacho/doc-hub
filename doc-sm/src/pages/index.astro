---
import Layout from '../layouts/Layout.astro';
import StoryMapBoard from '../components/board/StoryMapBoard.tsx';
import { swatchClass, kindLabel, kindDescription, KIND_ORDER } from '../lib/board/kinds';
import { docPortalUrl, practiceUrl, registryApiUrl, registryUrl, ticketingApiUrl } from '../lib/links';
import { fetchProducts } from '../lib/products';
import { isConfigured } from '../lib/ticketing';

// Server-rendered, like every other page in doc-hub.
//
// This page *was* prerendered, on the argument that it asked the server for
// nothing: the map comes from a file the visitor picks in their own browser. The
// product picker ended that. The list of registered products is read from
// doc-registry on every request, so the response is no longer identical for
// every visitor, and baking it at build time would hand out a catalogue that is
// stale the first time somebody registers a product.
//
// Deliberately uncached, for the reason doc-portal gives about its own catalogue
// fetch: a hub about how current your documentation is should not be the one
// page showing you a stale copy of it.
//
// fetchProducts never throws. An unreachable registry costs the picker, not the
// board — see the note at the top of src/lib/products.ts.
const { products, unavailable } = await fetchProducts(registryApiUrl());

const portal = docPortalUrl();
const practice = practiceUrl();
const registry = registryUrl();

// Whether a ticketing system is attached, and nothing more. The address itself
// is in-cluster and stays on this side — the board only needs to know whether
// offering to raise a ticket would be honest.
const ticketingConfigured = isConfigured(ticketingApiUrl());
---

<Layout
	title="Story mapping — doc-hub"
	description="A user story mapping board. Import and export a .storymap file; the board saves itself in your browser and nothing is stored on the server."
>
	<main id="main" class="mx-auto w-full max-w-[110rem] px-6 py-10">
		<header class="mb-8">
			<p class="text-xs font-semibold tracking-[0.16em] text-ink-muted uppercase dark:text-slate-400">
				doc-hub · story mapping
			</p>
			<h1 class="mt-2 text-3xl font-bold sm:text-4xl">Map the work before you plan it</h1>
			{/*
				One line, so no `max-w-prose`: a measure of 65ch is right for a
				paragraph and wrong for a standfirst, which is read at a glance
				rather than in lines.

				The sentence about what sits below the last band went with it. The
				band rail already says "Below the line — known, not committed to"
				on the board itself, and a header that explains what the board is
				about to show you is a header nobody reads twice.

				Not `whitespace-nowrap`: on a narrow window this wraps, which is the
				right outcome. Forcing it would push the page into a sideways
				scroll, and a header is not worth that.

				A brace comment rather than an HTML one: Astro ships HTML comments to
				the browser, and this is a note to the next author, not the reader.
			*/}
			<p class="mt-3 text-ink-muted dark:text-slate-400">
				Activities across the top, the steps beneath them, and the stories in the release that will
				carry them.
			</p>
		</header>

		{/*
			The legend is not decoration. Colour is kind on this board, and the rule
			that governs doc-portal's status palette governs these three too: colour
			is never the only signal. This says in words what the fills say in hue,
			and every card repeats it in its accessible name.
		*/}
		<section aria-labelledby="legend" class="mb-6">
			<h2 id="legend" class="sr-only">What the colours mean</h2>
			<ul class="flex flex-wrap gap-x-6 gap-y-2 text-sm">
				{
					KIND_ORDER.map((kind) => (
						<li class="flex items-center gap-2">
							<span class={`inline-block h-3.5 w-3.5 rounded-sm border ${swatchClass[kind]}`} aria-hidden="true" />
							<span class="font-semibold">{kindLabel[kind]}</span>
							<span class="text-ink-muted dark:text-slate-400">{kindDescription[kind]}</span>
						</li>
					))
				}
			</ul>
		</section>

		{/*
			The only hydrated component in doc-hub. See the header comment in
			StoryMapBoard.tsx for why this one earns it and a search form does not.

			client:only rather than client:load: there is nothing to server-render.
			The board's content comes from a file the visitor has not picked yet, so
			SSR would emit an empty grid, ship it, and throw it away — and it would
			invite hydration-mismatch warnings from the ids dnd-kit generates for its
			announcement region, for markup with no value.
		*/}
		<StoryMapBoard
			client:only="react"
			products={products}
			productsUnavailable={unavailable}
			registryUrl={registry}
			ticketingConfigured={ticketingConfigured}
		/>

		<noscript>
			<div class="rounded-2xl border border-slate-200 p-6 dark:border-slate-700">
				<h2 class="font-semibold">The board needs JavaScript</h2>
				<p class="mt-2 max-w-prose text-ink-muted dark:text-slate-400">
					A story map is edited by dragging cards, which is not something a page can do without
					scripting. The file format is plain text and is documented on
					<a class="font-semibold text-brand underline" href="/dsl">the format page</a>, which needs no
					scripting at all.
				</p>
			</div>
		</noscript>

		<footer class="mt-10 border-t border-slate-200 pt-6 text-sm text-ink-muted dark:border-slate-700 dark:text-slate-400">
          <p>
            Nothing here is stored on the server — the board keeps a copy in this browser, and that copy goes no further. The <code>.storymap</code> file you export is the map —
            keep it in the product's repository, next to the code it describes.
            The technique is written up in <a class="font-semibold text-brand underline" href={practice}>the development hub</a>.
            The <a class="font-semibold text-brand underline" href="/dsl">format is documented</a>, and
            the <a class="font-semibold text-brand underline" href={portal}>documentation portal</a> holds the product catalogue.
        </p>
		</footer>
	</main>
</Layout>
