---
/*
 * The details band of a product view: the registry entry, rendered.
 *
 * Everything here is a fact about the product rather than a measurement of it —
 * measurements are the band below. The split is deliberate: these values change
 * when a person changes them, the indicators change when a pipeline runs.
 */
import type { Product } from '../../lib/products';

interface Props {
	product: Product;
}

const { product } = Astro.props;

const lifecycle: Record<Product['lifecycle'], { label: string; note: string }> = {
	incubating: { label: 'Incubating', note: 'Under construction; interfaces still move.' },
	active: { label: 'Active', note: 'Developed and supported.' },
	maintained: { label: 'Maintained', note: 'Supported; no new capability planned.' },
	sunset: { label: 'Sunset', note: 'Being decommissioned; do not integrate.' },
};

const registered = new Date(product.registered).toLocaleDateString('en-GB', {
	year: 'numeric',
	month: 'long',
	day: 'numeric',
});

const facts = [
	{ term: 'Domain', value: product.domain },
	{ term: 'Owner', value: product.owner },
	{ term: 'Version', value: product.version },
	{ term: 'Lifecycle', value: lifecycle[product.lifecycle].label, note: lifecycle[product.lifecycle].note },
	{ term: 'Registered', value: registered },
];
---

<section aria-labelledby="product-details" class="mx-auto w-full max-w-5xl px-6 pt-12">
	<h2 id="product-details" class="text-xs font-semibold tracking-[0.14em] uppercase text-ink-muted dark:text-slate-400">
		Product details
	</h2>

	<div class="mt-5 rounded-2xl border border-slate-200 bg-white p-7 shadow-sm dark:border-slate-700 dark:bg-night-raised">
		<dl class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
			{
				facts.map(({ term, value, note }) => (
					<div>
						<dt class="text-sm text-ink-muted dark:text-slate-400">{term}</dt>
						<dd class="mt-1 text-lg font-semibold">{value}</dd>
						{note && <p class="mt-1 text-sm text-ink-muted dark:text-slate-400">{note}</p>}
					</div>
				))
			}

			<div>
				<dt class="text-sm text-ink-muted dark:text-slate-400">Contact</dt>
				<dd class="mt-1 text-lg font-semibold">
					<a
						href={`mailto:${product.contact}`}
						class="underline-offset-4 hover:text-brand hover:underline dark:hover:text-sky-400"
					>
						{product.contact}
					</a>
				</dd>
			</div>

			<div class="sm:col-span-2 lg:col-span-1">
				<dt class="text-sm text-ink-muted dark:text-slate-400">Repository</dt>
				<dd class="mt-1 font-semibold break-all">
					<a
						href={product.repository}
						rel="noreferrer"
						class="underline-offset-4 hover:text-brand hover:underline dark:hover:text-sky-400"
					>
						{product.repository.replace(/^https:\/\//, '')}
						<span class="sr-only"> (leaves this site)</span>
					</a>
				</dd>
			</div>
		</dl>

		<div class="mt-7 border-t border-slate-200 pt-5 dark:border-slate-800">
			<h3 class="text-sm text-ink-muted dark:text-slate-400">Tags</h3>
			<ul class="mt-3 flex flex-wrap gap-2">
				{
					product.tags.map((tag) => (
						<li>
							<a
								href={`/catalog?q=${encodeURIComponent(tag)}`}
								class="inline-block rounded-full bg-slate-100 px-3 py-1 text-sm font-medium text-ink-muted transition hover:bg-slate-200 hover:text-ink dark:bg-slate-700 dark:text-slate-300 dark:hover:bg-slate-600 dark:hover:text-slate-100"
							>
								{tag}
							</a>
						</li>
					))
				}
			</ul>
		</div>
	</div>
</section>
