---
/*
 * The card grid, used four times: the home page lists the three areas of the
 * hub, /landscape lists the two landscapes, and a product view lists the eight
 * perspectives on one product.
 *
 * Panels arrive as a prop rather than being baked in — there are several sets
 * and a hardcoded second component would drift from the first.
 *
 * `status` is what is actually reachable behind the link:
 *   live    — the link goes somewhere real
 *   soon    — the page exists and is worth opening, but the thing it describes
 *             is not built or not yet fed by automation
 *   planned — nothing behind it yet; the link is a placeholder
 * Flip a panel to `live` when its section ships.
 */
export type PanelStatus = 'live' | 'soon' | 'planned';

export interface Panel {
	title: string;
	description: string;
	href: string;
	cta: string;
	status: PanelStatus;
	/** A single SVG path `d`, stroked. Multiple subpaths are fine. */
	icon: string;
	/** Set for links that leave the portal, so they are marked and open safely. */
	external?: boolean;
}

interface Props {
	panels: readonly Panel[];
	/** Rendered as the section's accessible name. */
	label: string;
	/**
	 * Show `label` as a real heading, with an optional line under it.
	 *
	 * Off by default, which is right for the three places this component was
	 * built for: there the page's own hero has already said what the grid is, and
	 * a second visible heading over it would be the same sentence twice.
	 *
	 * /hub is the case that needed it. That page is several grids rather than
	 * one — a hub, then its portal and tools, then the next hub — and a reader
	 * has to be able to tell which cards belong to which hub. The heading is not
	 * decoration there; it is the only thing carrying that grouping.
	 */
	heading?: boolean;
	/** One line under the heading. Ignored unless `heading` is set. */
	lead?: string;
	/**
	 * Columns at the `lg` breakpoint. Two suits the pair of landscapes, three the
	 * three areas of the hub, four the eight product perspectives (4 + 4). Below
	 * `lg` they all fall back to the same two-column and single-column layouts.
	 */
	columns?: 2 | 3 | 4;
}

const { panels, label, columns = 3, heading = false, lead } = Astro.props;

// Written out in full rather than interpolated: Tailwind scans the source for
// class names and cannot see one assembled at runtime, so `lg:grid-cols-${n}`
// would emit no CSS and the grid would silently collapse to one column.
const gridClass = {
	2: 'grid gap-6 sm:grid-cols-2',
	3: 'grid gap-6 sm:grid-cols-2 lg:grid-cols-3',
	4: 'grid gap-6 sm:grid-cols-2 lg:grid-cols-4',
}[columns];

const badges: Record<PanelStatus, string | undefined> = {
	live: undefined,
	soon: 'Coming soon',
	planned: 'Planned',
};

const id = `panels-${label.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
---

<section aria-labelledby={id} class="mx-auto w-full max-w-5xl px-6 py-16 sm:py-20">
	{/* Same element and same id either way, so the section keeps its accessible
	    name whether or not the heading is drawn. A page that hides it is saying
	    the name is already on screen, not that it has none. */}
	<h2 id={id} class={heading ? 'text-2xl font-bold sm:text-3xl' : 'sr-only'}>{label}</h2>
	{heading && lead && <p class="mt-3 max-w-3xl text-ink-muted dark:text-slate-400">{lead}</p>}

	<ul class={`${gridClass}${heading ? ' mt-8' : ''}`}>
		{
			panels.map(({ title, description, href, cta, status, icon, external }) => (
				<li class="h-full">
					<a
						href={href}
						rel={external ? 'noreferrer' : undefined}
						class="group flex h-full flex-col rounded-2xl border border-slate-200 bg-white p-7 shadow-sm transition hover:-translate-y-0.5 hover:border-brand hover:shadow-md motion-reduce:hover:translate-y-0 dark:border-slate-700 dark:bg-night-raised dark:hover:border-sky-400"
					>
						<span class="flex items-center justify-between gap-3">
							<svg
								viewBox="0 0 24 24"
								class="h-8 w-8 text-brand dark:text-sky-400"
								fill="none"
								stroke="currentColor"
								stroke-width="1.6"
								stroke-linecap="round"
								stroke-linejoin="round"
								aria-hidden="true"
							>
								<path d={icon} />
							</svg>
							{badges[status] && (
								<span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold tracking-wide text-ink-muted uppercase dark:bg-slate-700 dark:text-slate-300">
									{badges[status]}
								</span>
							)}
						</span>

						<h3 class="mt-5 text-xl font-semibold">{title}</h3>
						<p class="mt-2 grow text-ink-muted dark:text-slate-400">{description}</p>
						<span class="mt-6 font-semibold text-brand dark:text-sky-400">
							{cta}
							{external && <span class="sr-only"> (leaves this site)</span>}
							<span
								aria-hidden="true"
								class="inline-block transition group-hover:translate-x-1 motion-reduce:transition-none"
							>
								{external ? <>&nbsp;↗</> : <>&nbsp;→</>}
							</span>
						</span>
					</a>
				</li>
			))
		}
	</ul>
</section>
