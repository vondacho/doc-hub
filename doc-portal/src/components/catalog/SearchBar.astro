---
/*
 * The search bar, on the home page and at the top of the catalog.
 *
 * A plain GET form, with no JavaScript on purpose:
 *
 *   - the query lands in the URL, so a search is linkable, bookmarkable, and
 *     survives a reload — which is most of what anyone wants from a search box;
 *   - it works before hydration, on a slow connection, and with scripting off;
 *   - the page is server-rendered anyway, so there is nothing to be gained by
 *     round-tripping through fetch().
 *
 * Add type-ahead the day the registry is behind this and the result set is big
 * enough for scanning to stop working — not before.
 */

interface Props {
	/** Prefilled on /catalog so the box still shows what was searched for. */
	query?: string;
	/** Rendered above the field. */
	label: string;
	/** Small print under the field. */
	hint?: string;
	/** Dark surfaces need light text; the home page banner is one. */
	tone?: 'light' | 'dark';
}

const { query = '', label, hint, tone = 'light' } = Astro.props;

const labelClass =
	tone === 'dark' ? 'text-slate-200' : 'text-ink-muted dark:text-slate-400';
const hintClass = tone === 'dark' ? 'text-slate-400' : 'text-ink-muted dark:text-slate-400';
---

<form
	action="/catalog"
	method="get"
	role="search"
	class="mx-auto w-full max-w-3xl"
>
	<label for="product-search" class={`block text-sm font-semibold ${labelClass}`}>
		{label}
	</label>

	<div class="mt-3 flex flex-col gap-3 sm:flex-row">
		<div class="relative grow">
			<svg
				viewBox="0 0 24 24"
				class="pointer-events-none absolute top-1/2 left-4 h-5 w-5 -translate-y-1/2 text-ink-muted dark:text-slate-400"
				fill="none"
				stroke="currentColor"
				stroke-width="1.8"
				stroke-linecap="round"
				aria-hidden="true"
			>
				<circle cx="11" cy="11" r="6.5" />
				<path d="m16 16 4.5 4.5" />
			</svg>
			<input
				id="product-search"
				type="search"
				name="q"
				value={query}
				autocomplete="off"
				placeholder="Product, domain, team or tag — for example “settlement”"
				class="w-full rounded-full border border-slate-300 bg-white py-3.5 pr-5 pl-12 text-ink shadow-sm placeholder:text-ink-muted focus-visible:border-brand focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand dark:border-slate-600 dark:bg-night-raised dark:text-slate-100 dark:placeholder:text-slate-500"
			/>
		</div>
		<button
			type="submit"
			class="rounded-full bg-brand px-7 py-3.5 font-semibold text-white transition hover:bg-brand-strong focus-visible:outline-2 focus-visible:outline-offset-3 focus-visible:outline-brand"
		>
			Search
		</button>
	</div>

	{hint && <p class={`mt-3 text-sm ${hintClass}`}>{hint}</p>}
</form>
