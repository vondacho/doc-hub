---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/home/Hero.astro';
import SectionPanels, { type Panel } from '../components/home/SectionPanels.astro';
import SearchBar from '../components/catalog/SearchBar.astro';
import SiteFooter from '../components/home/SiteFooter.astro';
import { products } from '../lib/products';

/*
 * The three areas of the hub.
 *
 * All three are `live`: the pages behind them exist and do what the panel says.
 * What is not built is *behind* the catalog — the per-product sections are
 * scaffolds and say so on their own pages, which is where that caveat belongs.
 */
const areas: readonly Panel[] = [
	{
		title: 'Catalog',
		description:
			'Every registered product, searchable by name, domain, owning team or tag — and behind each one, the eight perspectives on it.',
		href: '/catalog',
		cta: 'Browse the products',
		status: 'live',
		icon: 'M4 5.5A1.5 1.5 0 0 1 5.5 4H10v16H5.5A1.5 1.5 0 0 1 4 18.5v-13ZM10 4h8.5A1.5 1.5 0 0 1 20 5.5v13a1.5 1.5 0 0 1-1.5 1.5H10M13 8.5h4M13 12h4',
	},
	{
		title: 'Landscape',
		description:
			'The two views that cross products rather than describe one: the C4 model of the whole system, and the events that travel between its parts.',
		href: '/landscape',
		cta: 'See the landscapes',
		status: 'live',
		icon: 'M4 4h7v7H4V4Zm9 9h7v7h-7v-7ZM11 7.5h9M7.5 11v9',
	},
	{
		title: 'Registration',
		description:
			'Add a product to the registry: who owns it, where its code lives, and which pipelines will keep its documentation current.',
		href: '/registration',
		cta: 'Register a product',
		status: 'live',
		icon: 'M12 5v14m-7-7h14',
	},
] as const;
---

<Layout
	title="Doc Hub — living documentation, by product"
	description="Living documentation for every product: current, generated by automation, and organised for the people who ask what a product does rather than how it is built."
>
	<main id="main">
		<Hero
			kicker="Living documentation"
			title="Documentation that is generated, not remembered."
			lead="Wiki documentation states an intention, once, and starts ageing the same afternoon.
				Living documentation is produced by the pipelines that build, test and deploy the
				product, so it describes what is actually running. This hub is the product
				perspective on it — what each product does, for whom, where it is going, and what
				it looked like the last time it was measured."
			actions={[
				{ label: 'Browse the products', href: '/catalog' },
				{ label: 'Register a product', href: '/registration' },
			]}
		/>

		<SectionPanels panels={areas} label="Areas" columns={3} />

		<!--
			The same search as /catalog, on the home page.

			It submits to /catalog, so there is one result page rather than two, and
			one place where "how a product is found" is implemented. A visitor who
			already knows the product name never has to open the catalog and search a
			second time.
		-->
		<section
			aria-labelledby="home-search"
			class="border-t border-slate-200 bg-slate-50 px-6 py-16 sm:py-20 dark:border-slate-800 dark:bg-night-raised"
		>
			<div class="mx-auto w-full max-w-3xl text-center">
				<h2 id="home-search" class="text-2xl font-semibold sm:text-3xl">
					Looking for one product?
				</h2>
				<p class="mt-3 text-ink-muted dark:text-slate-400">
					{products.length} products are registered. Search them by name, domain, owning team or tag.
				</p>
			</div>
			<div class="mt-8">
				<SearchBar
					label="Search the catalog"
					hint="Or browse all of them, ten at a time, in the catalog."
				/>
			</div>
		</section>
	</main>
	<SiteFooter />
</Layout>
