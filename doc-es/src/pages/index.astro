---
import Layout from '../layouts/Layout.astro';
import EventStormBoard from '../components/board/EventStormBoard.tsx';
import { swatchClass } from '../lib/board/kinds';
import { cardLabel, cardMeaning, kindsFor } from '../lib/eventstorm/model';
import { promptsUrl, docPortalUrl, practiceUrl, registryApiUrl, registryUrl, storyMapperUrl } from '../lib/links';
import { fetchProducts } from '../lib/products';

// Server-rendered, like every other page in doc-hub.
//
// The wall comes from a file the visitor picks, but the product picker is read
// from doc-registry on every request, so the response is not identical for every
// visitor and baking it at build time would hand out a catalogue that is stale
// the first time somebody registers a product.
//
// fetchProducts never throws. An unreachable registry costs the picker, not the
// board — see the note at the top of src/lib/products.ts.
const { products, unavailable } = await fetchProducts(registryApiUrl());

const portal = docPortalUrl();
const practice = practiceUrl();
const registry = registryUrl();
// Browser-facing, and resolved here rather than in the island: `links.ts` reads
// `process.env`, which does not exist in a client bundle. Every other address
// the board renders is passed in the same way.
const prompts = promptsUrl();
const storyMapper = storyMapperUrl();
---

<Layout
  title="Event storming — doc-hub"
  description="A Big Picture event storming board. Import and export an .eventstorm file; the board saves itself in your browser and nothing is stored on the server."
>
  {/*
    Wider than a reading page, and deliberately not capped at a fixed width.

    A wall is not prose: the thing on screen is one long line of stickies in
    the order they happen, and every centimetre the window has spare is another
    event visible without scrolling sideways. A flat `110rem` cap gave a 32-inch
    monitor the same wall as a laptop and two hand-spans of white on either side
    of it, so it grows with the window and never takes less than 90% of it.

    The `max()` keeps the old width where it was the wider of the two — under
    about 1950px, 90vw is narrower than 110rem — so nothing changes on a laptop.

    dsl.astro and 404.astro stay at `max-w-5xl`: they are pages you read, and a
    line of prose 2000px long is worse than one with margins.
  */}
  <main id="main" class="mx-auto w-full max-w-[max(110rem,90vw)] px-6 py-10">
    <header class="mb-8">
      <p class="text-xs font-semibold tracking-[0.16em] text-ink-muted uppercase dark:text-slate-400">
        doc-hub · event storming
      </p>
      <h1 class="mt-2 text-3xl font-bold sm:text-4xl">Everything that happens, in order</h1>
      <p class="mt-3 text-ink-muted dark:text-slate-400">
        Domain events along a timeline, the actors and systems around them, and the disagreements
        nobody could settle — then commands and policies, then aggregates, as the room goes deeper.
      </p>
    </header>

    {/*
      The legend lives in the island now, not here.

      doc-sm and doc-em render theirs on the server, because their notations are
      fixed and the markup is the same for every visitor. This one grows with the
      level the visitor picks, so it has to live where that setting does — see
      Legend.tsx.

      What is left here is the big-picture six for `<noscript>`, which is the
      level every storm is at before it goes deeper, and the only one a server can
      know: the level is discovered from the cards, and this page has not read any.
      A reader without scripting cannot use the board, but they can still be told
      what the colours on an exported wall mean.
    */}
    <noscript>
      <section aria-labelledby="legend-static" class="mb-6">
        <h2 id="legend-static" class="sr-only">What the colours mean</h2>
        <ul class="flex flex-wrap gap-x-6 gap-y-2 text-sm">
          {
            kindsFor('big-picture').map((kind) => (
              <li class="flex items-center gap-2">
                <span class={`inline-block h-3.5 w-3.5 rounded-sm border ${swatchClass[kind]}`} aria-hidden="true" />
                <span class="font-semibold">{cardLabel[kind]}</span>
                <span class="text-ink-muted dark:text-slate-400">{cardMeaning[kind]}</span>
              </li>
            ))
          }
        </ul>
      </section>
    </noscript>

    <EventStormBoard
      client:only="react"
      products={products}
      productsUnavailable={unavailable}
      registryUrl={registry}
      promptsUrl={prompts}
    />

    <noscript>
      <div class="rounded-2xl border border-slate-200 p-6 dark:border-slate-700">
        <h2 class="font-semibold">The board needs JavaScript</h2>
        <p class="mt-2 max-w-prose text-ink-muted dark:text-slate-400">
          Notes are written and moved by hand, which is not something a page can do without scripting. The
          file format is plain text and is documented on
          <a class="font-semibold text-brand underline" href="/dsl">the format page</a>, which needs none.
        </p>
      </div>
    </noscript>

    <footer class="mt-10 border-t border-slate-200 pt-6 text-sm text-ink-muted dark:border-slate-700 dark:text-slate-400">
      <p>
        Nothing here is stored on the server — the board keeps a copy in this browser, and that copy goes no
        further. The <code>.eventstorm</code> file you export is the wall.
        The technique is written up in the <a class="font-semibold text-brand hover:underline" href={practice}>development hub</a>;
        the seams found here become bounded contexts, and the work they imply is cut in
        the <a class="font-semibold text-brand hover:underline" href={storyMapper}>Story mapper</a>.
        The <a class="font-semibold text-brand hover:underline" href="/dsl">format is documented</a>, and
        the <a class="font-semibold text-brand hover:underline" href={portal}>documentation portal</a> holds the product catalogue.
      </p>
    </footer>
  </main>
</Layout>
