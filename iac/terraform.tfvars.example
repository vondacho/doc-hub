# Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored.

# Contact address Let's Encrypt uses for expiry warnings. Five certificates are
# issued from this account.
acme_email = "you@example.com"

# Leave false in an account that already has a provider for
# token.actions.githubusercontent.com — AWS allows only one per issuer URL, and
# ba-hub already created this account's. Set it to true only in an account that
# has none; terraform plan checks either answer against the account before
# anything is created.
# Check by hand with: aws iam list-open-id-connect-providers
create_github_oidc_provider = false

# Optional — these are the defaults.
# Named profile from ~/.aws/config; omit to use the ambient credential chain.
# aws_profile       = "doc-hub"
# aws_region        = "eu-central-1"
# domain            = "obya.ch"
# instance_type     = "t3.small"
# root_volume_size  = 30
# github_repository = "vondacho/doc-hub"
# github_deploy_ref = "refs/heads/main"
# Must match the `environment:` name in the workflow's deploy job.
# github_deploy_environment = "production"

# Six containers on 2 GiB is tight and user-data.sh adds swap to make it fit.
# Move here if the host starts OOM-killing — the Elastic IP and the Docker
# volumes survive a stop/modify/start.
# instance_type = "t3.medium"

# The keys are compose service names and the values must match the site blocks
# in host/Caddyfile. Changing one means changing both, plus the DNS record.
# subdomains = {
#   doc-portal   = "doc-portal"
#   doc-registry = "doc-registry"
#   doc-sm       = "doc-sm"
#   doc-em       = "doc-em"
#   doc-es       = "doc-es"
# }

# Break-glass only. Both default to nothing: administration goes through SSM
# Session Manager, so the host normally has no key pair and no open port 22.
# ssh_key_name      = "doc-hub"
# ssh_allowed_cidrs = ["203.0.113.4/32"]
